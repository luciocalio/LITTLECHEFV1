# ════════════════════════════════════════════════
#  LITTLECHEF — Variabili d'ambiente
#  Copia questo file in .env.local e compila i valori.
#  In produzione le chiavi vanno su Vercel
#  (Settings → Environment Variables), mai nel codice.
# ════════════════════════════════════════════════

# Claude API per il Sous Chef.
# Solo sviluppo locale: dallo Stage 3 la chiave vive lato server
# (funzione /api/chat) col nome ANTHROPIC_API_KEY, senza prefisso VITE_.
VITE_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Supabase — chiave "publishable" (nuovo formato, equivale alla anon key):
# è pensata per il browser, la sicurezza dei dati dipende dalle policy RLS.
# NON usare mai la chiave secret/service_role.
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxx
